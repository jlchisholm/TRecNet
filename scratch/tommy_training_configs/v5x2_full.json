{
  "data": "/data/tommylub/h5_files/nom_ttbb_10jets_b1b2_train.h5",
  "xmaxmean": "/data/tommylub/maxmean/X_maxmean_nom_ttbb_10jets_b1b2_train.npy",
  "ymaxmean": "/data/tommylub/maxmean/Y_maxmean_nom_ttbb_10jets_b1b2_train.npy",

  "split": [70, 15, 15],
  "njets": 10,

  "max_epochs": 250,
  "patience": 25,

  "initial_lr": 0.0003,
  "final_lr_div": 20,
  "lr_power": 0.5,
  "lr_decay_step": 100000,

  "batch_size": 256,
  "optimizer": "adamw",

  "create": {
    "add_ttbar": true,
    "b_mode": "b1b2",
    "pretrained_jet_classifier": null,
    "pretrained_bb_classifier": null
  },

  "unfreeze": {
    "frozen_model": null
  },

  "hparams": {
    "d_model": 320,
    "ffn_dim": 768,
    "n_heads": 8,
    "n_blocks": 3,
    "enc_dropout": 0.05,

    "pool_heads": 8,
    "pool_dropout": 0.0,

    "cls_dropout": 0.05,
    "jet_cls_mlp": "128,128",
    "bjet_cls_mlp": "256,256",

    "other_dropout": 0.05,
    "other_mlp": "256,128",

    "final_dropout": 0.1,
    "final_mlp": "512,256,256,512",

    "head_dropout": 0.05,
    "lep_head": "384,192",
    "had_head": "384,192",
    "bb_head": "384,192",

    "trunk_ln_center": 1,
    "trunk_ln_scale": 0,

    "j_gate_pow": 1.25,
    "b_gate_scale": 0.5,
    "gate_temperature": 1.25,
    "gate_floor": 0.1
  }
