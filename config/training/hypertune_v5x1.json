{
  "data": "/data/tommylub/h5_files/nom_ttbb_10jets_b1b2_train.h5",
  "xmaxmean": "/data/tommylub/maxmean/X_maxmean_nom_ttbb_10jets_b1b2_train.npy",
  "ymaxmean": "/data/tommylub/maxmean/Y_maxmean_nom_ttbb_10jets_b1b2_train.npy",
  "split": [70, 15, 15],
  "njets": 10,

  "max_epochs": 15,
  "patience": 5,

  "initial_lr": 0.001,
  "final_lr_div": 20,
  "lr_power": 0.5,
  "lr_decay_step": 200000,
  "batch_size": 1024,
  "optimizer": "adamw",

  "create": {
    "add_ttbar": true,
    "b_mode": "b1b2",
    "pretrained_jet_classifier": null,
    "pretrained_bb_classifier": null
  },

  "unfreeze": { "frozen_model": null },

  "hparams": {
    "d_model": 192,
    "ffn_dim": 768,
    "n_heads": 8,
    "n_blocks": 3,
    "enc_dropout": 0.1
  },

  "hypertune": {
    "tuner": "Hyperband",
    "data_frac": 1.0,

    "hyperparams": {
      "initial_lr": { "type": "choice", "choices": [0.003, 0.001, 0.0003] },

      "final_lr_div": {
        "type": "int",
        "min_value": 20,
        "max_value": 200,
        "step": 10,
        "sampling": "log"
      },

      "lr_decay_step": {
        "type": "int",
        "min_value": 20000,
        "max_value": 500000,
        "step": 10,
        "sampling": "log"
      },

      "lr_power": {
        "type": "float",
        "min_value": 0.25,
        "max_value": 1.25,
        "step": 0.25,
        "sampling": "linear"
      },

      "batch_size": { "type": "choice", "choices": [256, 512, 1024, 2048] }
    },

    "arch_hyperparams": {
      "d_model": { "type": "choice", "choices": [128, 192, 256] },

      "ffn_dim": { "type": "choice", "choices": [512, 768, 1024] },

      "n_heads": { "type": "choice", "choices": [4, 8] },

      "n_blocks": { "type": "choice", "choices": [2, 3, 4, 5] },

      "enc_dropout": {
        "type": "float",
        "min_value": 0.0,
        "max_value": 0.25,
        "step": 0.05,
        "sampling": "linear"
      }
    }
  }
}