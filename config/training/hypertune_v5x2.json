{
  "data": "/data/tommylub/h5_files/nom_ttbb_10jets_b1b2_train.h5",
  "xmaxmean": "/data/tommylub/maxmean/X_maxmean_nom_ttbb_10jets_b1b2_train.npy",
  "ymaxmean": "/data/tommylub/maxmean/Y_maxmean_nom_ttbb_10jets_b1b2_train.npy",
  "split": [70, 15, 15],
  "njets": 10,

  "max_epochs": 15,
  "patience": 5,

  "initial_lr": 0.001,
  "final_lr_div": 30,
  "lr_power": 0.5,
  "lr_decay_step": 200000,
  "batch_size": 1024,
  "optimizer": "adamw",

  "create": {
    "add_ttbar": true,
    "b_mode": "b1b2",
    "pretrained_jet_classifier": null,
    "pretrained_bb_classifier": null
  },

  "unfreeze": { "frozen_model": null },

  "hparams": {
    "d_model": 256,
    "ffn_dim": 1024,
    "n_heads": 16,
    "n_blocks": 4,
    "enc_dropout": 0.1,

    "pool_heads": 8,
    "pool_dropout": 0.0,

    "use_rel_attn_bias": true,
    "rel_hidden": 32,
    "rel_head_scale": 1.0,

    "cls_activ": "gelu",
    "cls_dropout": 0.0,
    "jet_cls_mlp": [256, 256],
    "bjet_cls_mlp": [256, 256],

    "other_activ": "gelu",
    "other_dropout": 0.1,
    "other_mlp": [128, 64],

    "trunk_ln_center": false,
    "trunk_ln_scale": false,

    "final_activ": "gelu",
    "final_dropout": 0.1,
    "final_mlp": [512, 256, 128, 256, 512],

    "head_activ": "gelu",
    "head_dropout": 0.1,
    "lep_head": [256, 128],
    "had_head": [256, 128],
    "bb_head": [256, 128],

    "j_gate_pow": 1.0,
    "b_gate_scale": 0.5,
    "gate_temperature": 1.0,
    "gate_floor": 0.2,
    "gate_hard_threshold": null
  },

  "hypertune": {
    "tuner": "Hyperband",
    "data_frac": 1.0,

    "hyperparams": {
      "initial_lr": { "type": "choice", "choices": [0.003, 0.001, 0.0003, 0.0001] },
      "final_lr_div": { "type": "int", "min_value": 20, "max_value": 400, "step": 10, "sampling": "log" },
      "lr_decay_step": { "type": "int", "min_value": 10000, "max_value": 300000, "step": 10, "sampling": "log" },
      "lr_power": { "type": "float", "min_value": 0.25, "max_value": 1.25, "step": 0.25, "sampling": "linear" },

      "batch_size": { "type": "choice", "choices": [256, 512, 1024, 2048] }
    },

    "arch_hyperparams": {
      "d_model": { "type": "choice", "choices": [192, 256, 320] },
      "ffn_dim": { "type": "choice", "choices": [768, 1024, 1536] },

      "n_heads": { "type": "choice", "choices": [4, 8, 16] },
      "n_blocks": { "type": "choice", "choices": [2, 3, 4, 5] },
      "enc_dropout": { "type": "float", "min_value": 0.05, "max_value": 0.20, "step": 0.05, "sampling": "linear" },

      "pool_heads": { "type": "choice", "choices": [4, 8] },
      "pool_dropout": { "type": "float", "min_value": 0.0, "max_value": 0.10, "step": 0.05, "sampling": "linear" },

      "cls_dropout": { "type": "float", "min_value": 0.0, "max_value": 0.15, "step": 0.05, "sampling": "linear" },
      "jet_cls_mlp": { "type": "choice", "choices": ["128,128", "256,256"] },
      "bjet_cls_mlp": { "type": "choice", "choices": ["128,128", "256,256"] },

      "other_dropout": { "type": "float", "min_value": 0.0, "max_value": 0.20, "step": 0.05, "sampling": "linear" },
      "other_mlp": { "type": "choice", "choices": ["64,32", "128,64", "256,128"] },

      "final_dropout": { "type": "float", "min_value": 0.0, "max_value": 0.20, "step": 0.05, "sampling": "linear" },
      "final_mlp": { "type": "choice", "choices": ["256,128,256", "512,256,256,512"] },

      "head_dropout": { "type": "float", "min_value": 0.05, "max_value": 0.20, "step": 0.05, "sampling": "linear" },
      "lep_head": { "type": "choice", "choices": ["128,64", "256,128", "384,192"] },
      "had_head": { "type": "choice", "choices": ["128,64", "256,128", "384,192"] },
      "bb_head": { "type": "choice", "choices": ["128,64", "256,128", "384,192"] },

      "trunk_ln_center": { "type": "choice", "choices": [false, true] },
      "trunk_ln_scale": { "type": "choice", "choices": [false, true] },

      "j_gate_pow": { "type": "float", "min_value": 0.75, "max_value": 1.50, "step": 0.25, "sampling": "linear" },
      "b_gate_scale": { "type": "float", "min_value": 0.25, "max_value": 0.75, "step": 0.25, "sampling": "linear" },
      "gate_temperature": { "type": "float", "min_value": 0.75, "max_value": 1.50, "step": 0.25, "sampling": "linear" },
      "gate_floor": { "type": "float", "min_value": 0.10, "max_value": 0.30, "step": 0.05, "sampling": "linear" }
    }
  }
}
